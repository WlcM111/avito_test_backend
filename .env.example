# Local development defaults for docker compose.
# Copy to .env and adjust. Nothing in this file is a production secret: the
# passwords below exist only for the local stack.

LOG_LEVEL=info

# PostgreSQL. Порт хоста не 5432, чтобы стенд не конфликтовал с локально
# установленным PostgreSQL; внутри сети Compose адрес остаётся postgres:5432.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5499

# merchant-service database roles
MERCHANT_SVC_PASSWORD=merchant_svc
MERCHANT_MIGRATOR_PASSWORD=merchant_migrator

# inventory-service database roles
INVENTORY_SVC_PASSWORD=inventory_svc
INVENTORY_MIGRATOR_PASSWORD=inventory_migrator

# catalog-service database roles
CATALOG_SVC_PASSWORD=catalog_svc
CATALOG_MIGRATOR_PASSWORD=catalog_migrator

# order-service database roles
ORDERS_SVC_PASSWORD=orders_svc
ORDERS_MIGRATOR_PASSWORD=orders_migrator

# Published ports
MERCHANT_HTTP_PORT=8081
CATALOG_HTTP_PORT=8082
INVENTORY_HTTP_PORT=8083
ORDER_HTTP_PORT=8084
POS_HTTP_PORT=8085

# Служебные листенеры /healthz и /readyz. Внутри контейнера у всех 9091,
# на хосте разводятся по разным портам, иначе они конфликтуют.
MERCHANT_OPS_PORT=9091
CATALOG_OPS_PORT=9092
INVENTORY_OPS_PORT=9093
ORDER_OPS_PORT=9094
POS_OPS_PORT=9095

# inventory-service behaviour
RESERVATION_DEFAULT_TTL=30m
SWEEPER_INTERVAL=1m

# catalog-service behaviour: a published snapshot carries a whole menu
CATALOG_MAX_BODY_BYTES=1048576

# order-service behaviour. The reservation TTL must stay above the whole outbox
# retry window (about 23 minutes with the defaults below).
RESERVATION_TTL=30m
OUTBOX_INTERVAL=1s
OUTBOX_BATCH=50


# partner-pos: the demonstration till of one outlet. It authenticates with the
# access key of that outlet, exactly like a real point-of-sale integration.
PARTNER_POS_API_KEY=dev-merchant-key-kafe-primer-0001
POS_PUBLISH_ON_START=true
POS_STOCK_SYNC_INTERVAL=1m
POS_ORDER_POLL_INTERVAL=5s
POS_KITCHEN_STEP=20s

# Development merchant access keys created by migrations/merchant/0002_seed.sql.
# Only their SHA-256 digests are stored in the database.
DEV_MERCHANT_KEY_KAFE_PRIMER=dev-merchant-key-kafe-primer-0001
DEV_MERCHANT_KEY_SUSHI_VOLNA=dev-merchant-key-sushi-volna-0002
DEV_MERCHANT_KEY_PIZZA_FORNO=dev-merchant-key-pizza-forno-0003
